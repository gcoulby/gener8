    <eStructuralFeatures xsi:type="ecore:EReference" name="pos" upperBound="1" eType="#//PositionMotion" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="breathe" upperBound="1" eType="#//BreatheMotion" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PositionMotion" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="OrbitMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="orbit"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="radius" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phase" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DriftMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="drift"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amplitude" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rateBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PathMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="path"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="points" upperBound="-1" lowerBound="1" eType="#//PathPoint" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mode" eType="#//PathMode"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PathPoint">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON stores each point as a two element array [x, y]."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="PathMode">
    <eLiterals name="LOOP" value="0" literal="loop"/>
    <eLiterals name="PINGPONG" value="1" literal="pingpong"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BreatheMotion">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Field" abstract="true" eSuperTypes="#//SceneObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Fields act on members inside their shape. Handle values are 0 to 1 and are flattened into attributes."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="shape" upperBound="1" lowerBound="1" eType="#//Shape" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GeneratorField" abstract="true" eSuperTypes="#//Field"/>
  <eClassifiers xsi:type="ecore:EClass" name="TransformerField" abstract="true" eSuperTypes="#//Field"/>
  <eClassifiers xsi:type="ecore:EClass" name="FxField" abstract="true" eSuperTypes="#//Field"/>
  <eClassifiers xsi:type="ecore:EClass" name="InsertFx" abstract="true" eSuperTypes="#//FxField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Processes each member sound's mono signal."/>
      </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BusFx" abstract="true" eSuperTypes="#//FxField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Processes the zone's summed stereo send."/>
      </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MapField" abstract="true" eSuperTypes="#//Field">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Maps the position of the sounds inside it to placement through one or more Axis children, stored in JSON under axes keyed by the axis name. Not a processing stage: read directly by the engine before generators run. A sound inside several takes each target from the highest layer that sets it; outside all of them it sits at MIDI 60, centre pan. Selected by its edge or label only."/>
      </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="XYField" eSuperTypes="#//MapField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="rectangle"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="rectangle" value="shape.oclIsKindOf(Rectangle)"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Default shape: w=800 h=480. Default axes: x pan -1..1, y pitch 48..84. Has no handles. Edges are inclusive. Breathing scales the mapping with the shape."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="xy"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="x" upperBound="1" eType="#//Axis" containment="true">
        <eAnnotations source="http://gener8.app/ecore/json">
          <details key="key" value="axes.x"/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="y" upperBound="1" eType="#//Axis" containment="true">
        <eAnnotations source="http://gener8.app/ecore/json">
          <details key="key" value="axes.y"/>
        </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RadialField" eSuperTypes="#//MapField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="circleShape"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="circleShape" value="shape.oclIsKindOf(Circle)"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Circle with one axis, r, from the centre (min) out to the edge (max): a spotlight. Default shape: r=240. Default axis: level 0 dB at the centre to -24 dB at the edge."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="radial"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="r" upperBound="1" eType="#//Axis" containment="true">
        <eAnnotations source="http://gener8.app/ecore/json">
          <details key="key" value="axes.r"/>
        </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SweepField" eSuperTypes="#//MapField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="circleShape"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="circleShape" value="shape.oclIsKindOf(Circle)"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Circle with one axis, t, going round clockwise from straight up (min) back to straight up (max); pairs with orbit motion. Default shape: r=240. Default axis: pitch 48..72."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="sweep"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="t" upperBound="1" eType="#//Axis" containment="true">
        <eAnnotations source="http://gener8.app/ecore/json">
          <details key="key" value="axes.t"/>
        </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TriField" eSuperTypes="#//MapField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="circleShape"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="circleShape" value="shape.oclIsKindOf(Circle)"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Equilateral triangle stored as a Circle: r is the circumradius, corner a straight up, then b and c clockwise. Each axis runs from the edge opposite its corner (min) to the corner (max), as barycentric weights, so the three always blend (at the centre each is a third of the way). Default shape: r=260. Default axes: a pitch 48..84, b pan 0..1, c reach 0..12."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="tri"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="a" upperBound="1" eType="#//Axis" containment="true">
        <eAnnotations source="http://gener8.app/ecore/json">
          <details key="key" value="axes.a"/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="b" upperBound="1" eType="#//Axis" containment="true">
        <eAnnotations source="http://gener8.app/ecore/json">
          <details key="key" value="axes.b"/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="c" upperBound="1" eType="#//Axis" containment="true">
        <eAnnotations source="http://gener8.app/ecore/json">
          <details key="key" value="axes.c"/>
        </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Axis">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="knownTarget endRange"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="knownTarget" value="Set{'pitch', 'pan', 'level', 'reach', 'angle', 'spread'}-&gt;includes(to) or to.startsWith('param:')"/>
        <details key="endRange" value="min &gt;= -10000 and min &lt;= 10000 and max &gt;= -10000 and max &lt;= 10000"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Linear map along one axis of a MapField from its low end (min) to its high end (max): XYField x left to right and y bottom to top, RadialField centre to edge, SweepField once round clockwise from up, TriField opposite edge to corner. min greater than max inverts it. Targets and legal ranges (the mapped value is clamped to these): pitch MIDI 24..96 (snapped to the key afterwards), pan -1..1, level dB -40..12, reach 0..24 (× size), angle 0..360, spread 0..360 (degrees), falloff 0..1 (these four override RippleSettings). param:&lt;key&gt; drives that sound parameter, normalised 0..1 over its range, on sounds that have it."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="to" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="min" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="max" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PulseField" eSuperTypes="#//GeneratorField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Default shape: r=160."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="pulse"/>
