      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Circle with one axis, t, along a spiral wound out from the centre in three turns (centre min, edge max): angle gives the place within a turn, distance which turn. Default shape: r=240. Default axis: t pitch 48..84."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="spiral"/>
      </eAnnotations>
