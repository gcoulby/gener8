      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Circle with one axis, r, from the centre (min) out to the edge (max): a spotlight. Default shape: r=240. Default axis: level 0 dB at the centre to -24 dB at the edge."/>
