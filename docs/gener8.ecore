<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="gener8" nsURI="https://gener8.app/patch/2" nsPrefix="gener8">
  <eClassifiers xsi:type="ecore:EClass" name="Patch">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="seedRange tempoRange"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="seedRange" value="seed &gt;= 0 and seed &lt;= 4294967295"/>
        <details key="tempoRange" value="tempo &gt;= 20 and tempo &lt;= 300"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Root of a GENER8 patch file (src/core/types.ts Patch). seed is a uint32. tempo is clamped to 20..300 by the edit path. Version 2 adds XY fields; a version 1 patch (fixed y = pitch, x = pan) is migrated on load by adding the stage XYField that reproduces that mapping."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="format" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="gener8.patch"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="seed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tempo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="key" upperBound="1" lowerBound="1" eType="#//Key" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="master" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="-60"/>
          <details key="max" value="12"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Master level in dB. Optional; 0 when absent."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="info" upperBound="1" eType="#//PatchInfo" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="objects" upperBound="-1" eType="#//SceneObject" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PatchInfo">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="urlScheme"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="urlScheme" value="url.oclIsUndefined() or url.startsWith('http://') or url.startsWith('https://')"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Who made a patch and what it is (src/core/types.ts PatchInfo), shown when the patch is opened. Every field is optional and plain text, trimmed and cut on load (cleanInfo): title and artist to 80 characters, genre to 40, url to 200, notes to 2000. Only notes keeps line breaks. Never affects the sound."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="artist" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="genre" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="url" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="notes" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Key">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="rootRange"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="rootRange" value="root &gt;= 0 and root &lt;= 11"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="root is a pitch class 0 to 11."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="root" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scale" eType="#//Scale"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Scale">
    <eLiterals name="MAJOR" value="0" literal="major"/>
    <eLiterals name="LYDIAN" value="1" literal="lydian"/>
    <eLiterals name="MIXOLYDIAN" value="2" literal="mixolydian"/>
    <eLiterals name="DORIAN" value="3" literal="dorian"/>
    <eLiterals name="MINOR" value="4" literal="minor"/>
    <eLiterals name="PHRYGIAN" value="5" literal="phrygian"/>
    <eLiterals name="MAJORPENTATONIC" value="6" literal="majorPentatonic"/>
    <eLiterals name="MINORPENTATONIC" value="7" literal="minorPentatonic"/>
    <eLiterals name="WHOLETONE" value="8" literal="wholeTone"/>
    <eLiterals name="CHROMATIC" value="9" literal="chromatic"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SceneObject" abstract="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Anything on the canvas. layer is processing order, ties broken by id. The JSON kind and type pair is the class. x and y have no fixed meaning: XY fields map position to pitch, pan and the rest. Positions are clamped to ±8000."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="layer" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="motion" upperBound="1" eType="#//Motion" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="follow" upperBound="1" eType="#//SceneObject">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Group leader: this object adds the leader's motion offset (pose minus home) to its own position and multiplies in its breathing scale. Chains are followed up to 8 deep. Stored in JSON as the leader's id; dropped if it names no other object."/>
        </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Shape" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="Circle" eSuperTypes="#//Shape">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="r" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Rectangle" eSuperTypes="#//Shape">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="w" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="h" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Motion">
    <eStructuralFeatures xsi:type="ecore:EReference" name="pos" upperBound="1" eType="#//PositionMotion" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="breathe" upperBound="1" eType="#//BreatheMotion" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="spin" upperBound="1" eType="#//SpinMotion" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stretch" upperBound="1" eType="#//StretchMotion" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lag" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="With follow: trail the leader by this many beats (0 to 64)."/>
        </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PositionMotion" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="OrbitMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="orbit"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="radius" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phase" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ease" eType="#//Ease"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DriftMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="drift"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amplitude" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rateBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BounceMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Over the first half of the period it drops from height above home and bounces the given number of times (each reaching 0.45 of the last height, timed like free fall) until it touches down; the second half is the same in reverse, hopping back up to the top, so the cycle repeats without a jump."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="bounce"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="height" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bounces" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="0"/>
          <details key="max" value="12"/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PathMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="path"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="points" upperBound="-1" lowerBound="1" eType="#//PathPoint" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mode" eType="#//PathMode"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dwell" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Share of each segment spent waiting at its start point, 0 to 0.9."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ease" eType="#//Ease"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PathPoint">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON stores each point as a two element array [x, y]."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="PathMode">
    <eLiterals name="LOOP" value="0" literal="loop"/>
    <eLiterals name="PINGPONG" value="1" literal="pingpong"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BreatheMotion">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="shape" eType="#//BreatheShape" defaultValueLiteral="sine"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Ease">
    <eLiterals name="LINEAR" value="0" literal="linear"/>
    <eLiterals name="SMOOTH" value="1" literal="smooth"/>
    <eLiterals name="ELASTIC" value="2" literal="elastic"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="BreatheShape">
    <eLiterals name="SINE" value="0" literal="sine"/>
    <eLiterals name="TRI" value="1" literal="tri"/>
    <eLiterals name="RAMP" value="2" literal="ramp"/>
    <eLiterals name="SQUARE" value="3" literal="square"/>
    <eLiterals name="STEP" value="4" literal="step"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PendulumMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Hangs from a pivot length above home and swings ±swing degrees, slowing at the ends."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="pendulum"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="length" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="swing" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Degrees each way, 0 to 170."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LissajousMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="x and y oscillate at a : b times per period, tracing a closed figure (1:2 is a figure eight)."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="lissajous"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="a" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="x frequency, 1 to 8."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="b" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="y frequency, 1 to 8."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpiralMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Winds out to radius and back in, turns times each way, once per period."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="spiral"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="radius" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="turns" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="0.5 to 8."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RoseMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A rose curve r = size · cos(kθ) with the given number of petals, passing through home between each."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="rose"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="petals" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="2 to 9."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpirographMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A hypotrochoid: a circle rolling inside one of radius, drawing lobes loops; arm is how far out the pen sits."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="spirograph"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="radius" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lobes" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="2 to 12."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arm" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="0 to 1."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="HopMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Jumps between spots seeded points within distance, one hop every everyBeats, gliding over the first fifth of each step. Never the same spot twice running."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="hop"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="distance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="spots" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="2 to 8."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="everyBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpringMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Once per period it is flicked out stretch in a seeded direction and wobbles back to rest; damping sets how fast it settles."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="spring"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stretch" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="damping" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="0 to 1."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ShuttleMotion" eSuperTypes="#//PositionMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Back and forth along a line at angle, distance either side of home."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="shuttle"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="angle" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Degrees clockwise from up."/>
        </eAnnotations>
    </eStructuralFeatures>
