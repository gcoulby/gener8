        <details key="documentation" value="Default shape: r=120."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="probability"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bias" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0.7"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TransposeField" eSuperTypes="#//TransformerField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Default shape: r=120."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="transpose"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0.75"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QuantiseField" eSuperTypes="#//TransformerField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Default shape: r=130."/>
      </eAnnotations>
