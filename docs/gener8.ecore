  <eClassifiers xsi:type="ecore:EClass" name="Sound" abstract="true" eSuperTypes="#//SceneObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="size is the diameter on screen and sets level (48 is 0 dB) and, with ripple reach, how far its retriggers travel."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="note" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="60">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="24"/>
          <details key="max" value="96"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="MIDI note it plays wherever no map field sets pitch (snapped to the key like any pitch). Optional in JSON."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ripple" upperBound="1" eType="#//RippleSettings" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="midiOut" upperBound="1" eType="#//MidiOut" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RippleSettings">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How a sound retriggers listeners when it plays (event sounds only, up to chain depth 4). Every attribute is optional in JSON and falls back to its default. Retriggers travel at 240 units a beat and lose strength by falloff."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mode" eType="#//RippleMode" defaultValueLiteral="ripple"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="angle" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="0"/>
          <details key="max" value="360"/>
          <details key="unit" value="°"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Direction of a point trace, or the centre of a multi fan. Clockwise from straight up."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="3">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="1"/>
          <details key="max" value="16"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Number of traces in multi mode."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="spread" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="90">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="0"/>
          <details key="max" value="360"/>
          <details key="unit" value="°"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Fan width in multi mode. 360 spaces the traces evenly all the way round."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reach" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="6">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="0"/>
          <details key="max" value="24"/>
          <details key="unit" value="× size"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="How far the ring or traces travel, as a multiple of the sound's size. 0 never retriggers."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="falloff" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="1">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="0"/>
          <details key="max" value="1"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Strength lost on the way: velocity × (1 − falloff × distance / reach) × 0.9. 1 fades to nothing at the reach; 0 hits as hard at the reach as next door."/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stop" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Stop on impact: the ring, or each trace, ends at the first listener it reaches."/>
        </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MidiOut">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Set from the mixer: the sound’s notes also go to the MIDI output on channel (1 to 16). With only, its own audio is silenced."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="channel" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://gener8.app/ecore/range">
          <details key="min" value="1"/>
          <details key="max" value="16"/>
        </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="only" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
  </eClassifiers>
