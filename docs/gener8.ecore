      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="rectangle" value="shape.oclIsKindOf(Rectangle)"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Default shape: w=800 h=480. Default axes: x pan -1..1, y pitch 48..84. Has no handles. Edges are inclusive. Breathing scales the mapping with the shape."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="xy"/>
      </eAnnotations>
