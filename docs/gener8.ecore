  <eClassifiers xsi:type="ecore:EClass" name="Axis">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="knownTarget endRange"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="knownTarget" value="Set{'pitch', 'pan', 'level', 'reach', 'angle', 'spread'}-&gt;includes(to) or to.startsWith('param:')"/>
        <details key="endRange" value="min &gt;= -10000 and min &lt;= 10000 and max &gt;= -10000 and max &lt;= 10000"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Linear map along one axis of a MapField from its low end (min) to its high end (max): XYField x left to right and y bottom to top, RadialField centre to edge, SweepField once round clockwise from up, TriField opposite edge to corner. min greater than max inverts it. Targets and legal ranges (the mapped value is clamped to these): pitch MIDI 24..96 (snapped to the key afterwards), pan -1..1, level dB -40..12, reach 0..24 (× size), angle 0..360, spread 0..360 (degrees), falloff 0..1 (these four override RippleSettings). param:&lt;key&gt; drives that sound parameter, normalised 0..1 over its range, on sounds that have it."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="to" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="min" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="max" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
