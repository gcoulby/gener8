<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="gener8" nsURI="https://gener8.app/patch/2" nsPrefix="gener8">
  <eClassifiers xsi:type="ecore:EClass" name="Patch">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="seedRange tempoRange"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="seedRange" value="seed &gt;= 0 and seed &lt;= 4294967295"/>
        <details key="tempoRange" value="tempo &gt;= 20 and tempo &lt;= 300"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Root of a GENER8 patch file (src/core/types.ts Patch). seed is a uint32. tempo is clamped to 20..300 by the edit path. Version 2 adds XY fields; a version 1 patch (fixed y = pitch, x = pan) is migrated on load by adding the stage XYField that reproduces that mapping."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="format" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="gener8.patch"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="seed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tempo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="key" upperBound="1" lowerBound="1" eType="#//Key" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="objects" upperBound="-1" eType="#//SceneObject" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Key">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="rootRange"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="rootRange" value="root &gt;= 0 and root &lt;= 11"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="root is a pitch class 0 to 11."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="root" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scale" eType="#//Scale"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Scale">
    <eLiterals name="MAJOR" value="0" literal="major"/>
    <eLiterals name="LYDIAN" value="1" literal="lydian"/>
    <eLiterals name="MIXOLYDIAN" value="2" literal="mixolydian"/>
    <eLiterals name="DORIAN" value="3" literal="dorian"/>
    <eLiterals name="MINOR" value="4" literal="minor"/>
    <eLiterals name="PHRYGIAN" value="5" literal="phrygian"/>
    <eLiterals name="MAJORPENTATONIC" value="6" literal="majorPentatonic"/>
    <eLiterals name="MINORPENTATONIC" value="7" literal="minorPentatonic"/>
    <eLiterals name="WHOLETONE" value="8" literal="wholeTone"/>
    <eLiterals name="CHROMATIC" value="9" literal="chromatic"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SceneObject" abstract="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Anything on the canvas. layer is processing order, ties broken by id. The JSON kind and type pair is the class. x and y have no fixed meaning: XY fields map position to pitch, pan and the rest. Positions are clamped to ±8000."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="layer" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="motion" upperBound="1" eType="#//Motion" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Shape" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="Circle" eSuperTypes="#//Shape">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="r" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Rectangle" eSuperTypes="#//Shape">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="w" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="h" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
