  <eClassifiers xsi:type="ecore:EClass" name="SpinMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Turns once every periodBeats, clockwise unless ccw. A spinning field carries its geometry round: members, maps axes and generator patterns rotate with it; a spinning sound turns its point and multi retriggers."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ccw" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="StretchMotion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Fields only: width grows by amount while height shrinks by the same factor, and back, every periodBeats."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodBeats" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Field" abstract="true" eSuperTypes="#//SceneObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Fields act on members inside their shape. Handle values are 0 to 1 and are flattened into attributes."/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="shape" upperBound="1" lowerBound="1" eType="#//Shape" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GeneratorField" abstract="true" eSuperTypes="#//Field"/>
