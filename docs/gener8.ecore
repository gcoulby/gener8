      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Rectangle tiled with the tonnetz: the axis n is the hex cell’s offset from the centre in semitones (fifths to the right, major thirds up-right), folded into −6..+6. Default shape: w=640 h=440. Default axis: n pitch 54..66."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="tonnetz"/>
      </eAnnotations>
