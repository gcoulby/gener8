  <eClassifiers xsi:type="ecore:EClass" name="TriField" eSuperTypes="#//MapField">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="circleShape"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="circleShape" value="shape.oclIsKindOf(Circle)"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Equilateral triangle stored as a Circle: r is the circumradius, corner a straight up, then b and c clockwise. Each axis runs from the edge opposite its corner (min) to the corner (max), as barycentric weights, so the three always blend (at the centre each is a third of the way). Default shape: r=260. Default axes: a pitch 48..84, b pan 0..1, c reach 0..12."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="tri"/>
      </eAnnotations>
