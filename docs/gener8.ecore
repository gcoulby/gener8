        <details key="documentation" value="Default shape: r=160."/>
      </eAnnotations>
      <eAnnotations source="http://gener8.app/ecore/json">
        <details key="type" value="strum"/>
      </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="every" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0.5"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="spread" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0.4"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GridField" eSuperTypes="#//GeneratorField">
